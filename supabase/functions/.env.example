# Copy to supabase/functions/.env for local Edge Functions. Never commit the real file.
# Use Stripe TEST keys only (sk_test_..., whsec_...).
APP_URL=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Shared secret for the nightly evidence-file cleanup (purge-expired-files). Any long random
# value; the same value goes into Vault as purge_files_secret on the hosted project.
PURGE_FILES_SECRET=replace_with_a_long_random_value
# Miles (customer service AI): your Anthropic API key from console.anthropic.com. Never commit it.
ANTHROPIC_API_KEY=sk-ant-replace_me
# Optional: the email Miles gives people who need a human.
# SUPPORT_EMAIL=help@example.com
