# Copy of what `npm run setup:env` writes to .env.local for local development.
# Never put secret or service_role keys in any VITE_ variable: they ship to browsers.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_me
# Optional: where the admin panel lives (shown to moderators in the account menu).
# VITE_ADMIN_URL=https://admin.example.com
# Optional: error tracking (Sentry). Leave empty locally; set as a GitHub variable for hosted builds.
# VITE_SENTRY_DSN=https://publickey@o0.ingest.us.sentry.io/0
# Optional: cookie-free visitor counts on the landing page (Cloudflare Web Analytics).
# VITE_CF_ANALYTICS_TOKEN=
# Optional: where "Contact us" for the Business plan sends email (landing page pricing).
# VITE_CONTACT_EMAIL=hello@clientshield.example
