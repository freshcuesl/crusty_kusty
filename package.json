{
  "name": "clientshield",
  "private": true,
  "description": "ClientShield: a verified incident network for service businesses.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @cs/web",
    "dev:admin": "npm run dev -w @cs/admin",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e -w @cs/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "setup:env": "node scripts/setup-env.mjs",
    "db:status": "supabase status",
    "audit": "npm audit --audit-level=high",
    "make-admin": "node scripts/make-admin.mjs",
    "setup:env:cloud": "node scripts/setup-env.mjs --cloud",
    "db:login": "supabase login",
    "db:link": "supabase link --project-ref mnmlvmctxponwzltixub",
    "db:push": "supabase db push",
    "db:config:push": "supabase config push"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@supabase/supabase-js": "^2.117.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.2"
  }
}
